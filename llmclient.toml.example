# Copy this file to llmclient.toml and fill in the values for your setup.
# llmclient never reads API keys from this file directly; secrets are
# resolved from the environment variable named by each vendor's
# `api_key_env` key.

[defaults]
vendor = "anthropic"
model = "claude-sonnet-5"
timeout_seconds = 60

[vendor.anthropic]
api_key_env = "ANTHROPIC_API_KEY"
default_model = "claude-sonnet-5"

[vendor.google]
api_key_env = "GOOGLE_API_KEY"
default_model = "gemini-2.5-pro"

[budget]
monthly_limit_usd = 50.0
alert_threshold_pct = 80
